 "hr_pre": "75",
 "hr_post": "29",
 "lines": [
  {
   "id": "l1",
   "text": "This is a normal heartbeat.",
   "at": 0.76,
   "end": 2.13
  },
  {
   "id": "l2",
   "text": "The SA node fires, the signal travels down through the AV node, and both ventricles squeeze together.",
   "at": 2.55,
   "end": 8.39
  },
  {
   "id": "l3",
   "text": "Now watch what happens in third-degree heart block.",
   "at": 8.93,
   "end": 11.34
  },
  {
   "id": "l4",
   "text": "No signal gets from the atria down to the ventricles. The atria and ventricles each fire on their own clocks.",
   "at": 11.78,
   "end": 18.39
  },
  {
   "id": "l5",
   "text": "A slow backup pacemaker below the block keeps the heart going, often at only 20 to 40 beats a minute.",
   "at": 18.9,
   "end": 24.8
  },
  {
   "id": "l6",
   "text": "Put pacing pads on. If unstable, give atropine, but don't count on it. Pace, or start an epinephrine drip.",
   "at": 25.34,
   "end": 33.56
  },
  {
   "id": "l7",
   "text": "Practice it on ACLSMED Sim. ACLSmed dot com.",
   "at": 34.15,
   "end": 38.73
  }
 ],
