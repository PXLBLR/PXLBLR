 "duration": 39.96,
 "onset": 8.67,
 "key": 23.45,
 "action": 25.29,
 "end_card": 32.88,
 "post_shift": 8.17,
 "hr_pre": "75",
 "hr_post": "72",
 "lines": [
  {
   "id": "l1",
   "text": "This is a normal heartbeat.",
   "at": 0.75,
   "end": 2.13
  },
  {
   "id": "l2",
   "text": "The SA node fires, the signal travels down through the AV node, and both ventricles squeeze together.",
   "at": 2.55,
   "end": 8.39
  },
  {
   "id": "l3",
   "text": "Now watch what happens in PEA, pulseless electrical activity.",
   "at": 8.92,
   "end": 12.42
  },
  {
   "id": "l4",
   "text": "The electrical signal still fires, so the monitor shows an organized rhythm. But the heart isn't moving enough blood to make a pulse.",
   "at": 12.86,
   "end": 20.59
  },
  {
   "id": "l5",
   "text": "The rhythm can look almost normal. But there's no pulse.",
   "at": 21.15,
   "end": 24.75
  },
  {
   "id": "l6",
   "text": "PEA is not shockable. Start CPR, give epinephrine as soon as possible, and look for the cause.",
   "at": 25.29,
   "end": 32.53
  },
  {
   "id": "l7",
   "text": "Practice it on ACLSMED Sim. ACLSmed dot com.",
   "at": 33.18,
   "end": 37.76
  }
 ],
