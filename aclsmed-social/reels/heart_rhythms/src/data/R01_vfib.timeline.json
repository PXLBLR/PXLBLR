 "lines": [
  {
   "id": "l1",
   "text": "This is a normal heartbeat.",
   "at": 0.75,
   "end": 2.13
  },
  {
   "id": "l2",
   "text": "The SA node fires, the signal travels down through the AV node, and both ventricles squeeze together.",
   "at": 2.55,
   "end": 8.39
  },
  {
   "id": "l3",
   "text": "Now watch what happens in V-fib.",
   "at": 9.17,
   "end": 10.8
  },
  {
   "id": "l4",
   "text": "The electrical activity in the ventricles turns chaotic. Instead of squeezing, they just quiver.",
   "at": 11.24,
   "end": 17.06
  },
  {
   "id": "l5",
   "text": "And with no squeeze, there's no cardiac output. No pulse.",
   "at": 17.63,
   "end": 21.63
  },
  {
   "id": "l6",
   "text": "V-fib is a shockable rhythm. Start CPR, and defibrillate as soon as possible.",
   "at": 22.22,
   "end": 27.82
  },
  {
   "id": "l7",
   "text": "Practice it on ACLSMED Sim. ACLSmed dot com.",
   "at": 28.41,
   "end": 32.99
  }
 ],
