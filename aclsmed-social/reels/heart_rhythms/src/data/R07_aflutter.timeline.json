 "hr_pre": "75",
 "hr_post": "150",
 "lines": [
  {
   "id": "l1",
   "text": "This is a normal heartbeat.",
   "at": 0.75,
   "end": 2.13
  },
  {
   "id": "l2",
   "text": "The SA node fires, the signal travels down through the AV node, and both ventricles squeeze together.",
   "at": 2.55,
   "end": 8.39
  },
  {
   "id": "l3",
   "text": "Now watch what happens in atrial flutter.",
   "at": 8.93,
   "end": 10.93
  },
  {
   "id": "l4",
   "text": "One electrical loop circles the right atrium about 300 times a minute, drawing a sawtooth on the monitor.",
   "at": 11.35,
   "end": 17.51
  },
  {
   "id": "l5",
   "text": "Often the AV node passes every second wave, so the heart rate sits near 150.",
   "at": 17.98,
   "end": 23.66
  },
  {
   "id": "l6",
   "text": "If the patient is unstable, use synchronized cardioversion. If stable, control the rate, and remember flutter carries stroke risk too.",
   "at": 24.18,
   "end": 32.13
  },
  {
   "id": "l7",
   "text": "Practice it on ACLSMED Sim. ACLSmed dot com.",
   "at": 32.72,
   "end": 37.3
  }
 ],
