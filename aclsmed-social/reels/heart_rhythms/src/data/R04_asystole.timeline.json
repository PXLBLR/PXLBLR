 "lines": [
  {
   "id": "l1",
   "text": "This is a normal heartbeat.",
   "at": 0.75,
   "end": 2.13
  },
  {
   "id": "l2",
   "text": "The SA node fires, the signal travels down through the AV node, and both ventricles squeeze together.",
   "at": 2.55,
   "end": 8.39
  },
  {
   "id": "l3",
   "text": "Now watch what happens in asystole.",
   "at": 8.93,
   "end": 10.98
  },
  {
   "id": "l4",
   "text": "All electrical activity stops. Nothing fires, and the heart stays still.",
   "at": 11.42,
   "end": 15.97
  },
  {
   "id": "l5",
   "text": "A flat line, and no pulse. Check the leads and the gain, so fine V-fib isn't missed.",
   "at": 16.47,
   "end": 22.18
  },
  {
   "id": "l6",
   "text": "Asystole is not shockable. Start CPR, give epinephrine as soon as possible, and look for the cause.",
   "at": 22.73,
   "end": 30.13
  },
  {
   "id": "l7",
   "text": "Practice it on ACLSMED Sim. ACLSmed dot com.",
   "at": 30.78,
   "end": 35.36
  }
 ],
