 "hr_pre": "75",
 "hr_post": "185",
 "lines": [
  {
   "id": "l1",
   "text": "This is a normal heartbeat.",
   "at": 0.76,
   "end": 2.13
  },
  {
   "id": "l2",
   "text": "The SA node fires, the signal travels down through the AV node, and both ventricles squeeze together.",
   "at": 2.55,
   "end": 8.39
  },
  {
   "id": "l3",
   "text": "Now watch what happens in SVT.",
   "at": 8.93,
   "end": 10.79
  },
  {
   "id": "l4",
   "text": "In the most common type, a tiny short circuit in the AV node sends the signal spinning around again and again.",
   "at": 11.22,
   "end": 17.79
  },
  {
   "id": "l5",
   "text": "Every lap fires the ventricles, so the heart races at well over 150 beats a minute.",
   "at": 18.33,
   "end": 24.1
  },
  {
   "id": "l6",
   "text": "If the patient is stable, try vagal maneuvers, then adenosine. If unstable, use synchronized cardioversion.",
   "at": 24.68,
   "end": 31.74
  },
  {
   "id": "l7",
   "text": "Practice it on ACLSMED Sim. ACLSmed dot com.",
   "at": 32.32,
   "end": 36.9
  }
 ],
