 "hr_post": "50",
 "lines": [
  {
   "id": "l1",
   "text": "This is a normal heartbeat.",
   "at": 0.75,
   "end": 2.13
  },
  {
   "id": "l2",
   "text": "The SA node fires, the signal travels down through the AV node, and both ventricles squeeze together.",
   "at": 2.55,
   "end": 8.39
  },
  {
   "id": "l3",
   "text": "Now watch what happens in Mobitz type two heart block.",
   "at": 8.97,
   "end": 11.65
  },
  {
   "id": "l4",
   "text": "The atria keep firing on time, but some signals suddenly stop below the AV node, with no warning.",
   "at": 12.08,
   "end": 17.82
  },
  {
   "id": "l5",
   "text": "Every dropped beat is a missing heartbeat, and it can progress to complete heart block.",
   "at": 18.31,
   "end": 22.81
  },
  {
   "id": "l6",
   "text": "Pads on. If unstable, try atropine, but it often fails here. Then pace, or start an epinephrine drip.",
   "at": 23.53,
   "end": 32.57
  },
  {
   "id": "l7",
   "text": "Practice it on ACLSMED Sim. ACLSmed dot com.",
   "at": 33.16,
   "end": 37.74
  }
 ],
