{
 "id": "R03_torsades",
 "n": 3,
 "mode": "full",
 "duration": 42.02,
 "onset": 12.58,
 "key": 22.38,
 "action": 25.7,
 "end_card": 34.94,
 "post_shift": 12.08,
 "hr_pre": "70",
 "hr_post": "225",
 "lines": [
  {
   "id": "l1",
   "text": "This heart is in sinus rhythm, but look how long it takes from each spike to the end of its T wave.",
   "at": 0.75,
   "end": 5.99
  },
  {
   "id": "l2",
   "text": "That's a long QT. The ventricles take longer than normal to reset, and that leaves them vulnerable.",
   "at": 6.38,
   "end": 12.29
  },
  {
   "id": "l3",
   "text": "Now watch what happens in torsades de pointes.",
   "at": 12.83,
   "end": 15.47
  },
  {
   "id": "l4",
   "text": "A fast ventricular rhythm twists around the baseline, the complexes growing and shrinking like a ribbon.",
   "at": 16.05,
   "end": 21.88
  },
  {
   "id": "l5",
   "text": "It can stop on its own, or turn into V-fib.",
   "at": 22.38,
   "end": 25.16
  },
  {
   "id": "l6",
   "text": "If it keeps going, defibrillate right away, pulse or not, and start CPR if there's no pulse. IV magnesium helps stop it coming back.",
   "at": 25.7,
   "end": 34.65
  },
  {
   "id": "l7",
   "text": "Practice it on ACLSMED Sim. ACLSmed dot com.",
   "at": 35.24,
   "end": 39.82
  }
 ],
