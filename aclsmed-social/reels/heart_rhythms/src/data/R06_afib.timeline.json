 "hr_pre": "75",
 "hr_post": "147",
 "lines": [
  {
   "id": "l1",
   "text": "This is a normal heartbeat.",
   "at": 0.76,
   "end": 2.13
  },
  {
   "id": "l2",
   "text": "The SA node fires, the atria squeeze, then the signal passes through the AV node and both ventricles squeeze.",
   "at": 2.54,
   "end": 9.87
  },
  {
   "id": "l3",
   "text": "Now watch what happens in A-fib.",
   "at": 10.45,
   "end": 12.37
  },
  {
   "id": "l4",
   "text": "The atria no longer squeeze. They just quiver, firing hundreds of chaotic signals a minute.",
   "at": 12.8,
   "end": 18.8
  },
  {
   "id": "l5",
   "text": "The AV node lets only some of them through, so the heartbeat becomes irregularly irregular.",
   "at": 19.28,
   "end": 24.82
  },
  {
   "id": "l6",
   "text": "If the patient is unstable, use synchronized cardioversion. If stable, slow the rate and think about stroke risk.",
   "at": 25.34,
   "end": 32.0
  },
  {
   "id": "l7",
   "text": "Practice it on ACLSMED Sim. ACLSmed dot com.",
   "at": 32.59,
   "end": 37.17
  }
 ],
