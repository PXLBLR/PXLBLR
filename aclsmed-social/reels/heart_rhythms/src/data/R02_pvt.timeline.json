 "hr_pre": "75",
 "hr_post": "168",
 "lines": [
  {
   "id": "l1",
   "text": "This is a normal heartbeat.",
   "at": 0.75,
   "end": 2.13
  },
  {
   "id": "l2",
   "text": "The SA node fires, the signal travels down through the AV node, and both ventricles squeeze together.",
   "at": 2.55,
   "end": 8.39
  },
  {
   "id": "l3",
   "text": "Now watch what happens in pulseless V-tach.",
   "at": 8.93,
   "end": 11.07
  },
  {
   "id": "l4",
   "text": "One spot in the ventricle takes over and fires a fast loop of its own, bypassing the normal pathway.",
   "at": 11.5,
   "end": 16.95
  },
  {
   "id": "l5",
   "text": "The ventricles race too fast to fill, and too little blood gets out. No pulse.",
   "at": 17.47,
   "end": 22.74
  },
  {
   "id": "l6",
   "text": "Pulseless V-tach is shockable. Start CPR, and defibrillate as soon as possible.",
   "at": 23.38,
   "end": 28.96
  },
  {
   "id": "l7",
   "text": "Practice it on ACLSMED Sim. ACLSmed dot com.",
   "at": 29.55,
   "end": 34.13
  }
 ],
